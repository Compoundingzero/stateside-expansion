PUBLIC_SITE_URL=https://your-domain.example
PORT=3000

# Local submission storage; production uses the mounted Railway /data volume.
ELN_DATA_DIRECTORY=./data
ELN_RETENTION_DAYS=365
# Generate a fresh random token of at least 32 characters; never commit the value.
ELN_SETUP_TOKEN=

# Public HTML-tag ownership tokens, copied from your own provider accounts.
# Values only (not the complete meta tags); leave blank until issued.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Daily encrypted off-volume backup. Supply every required value to enable.
ELN_BACKUP_ENDPOINT=
ELN_BACKUP_BUCKET=
ELN_BACKUP_REGION=
ELN_BACKUP_ACCESS_KEY_ID=
ELN_BACKUP_SECRET_ACCESS_KEY=
ELN_BACKUP_ENCRYPTION_KEY=
ELN_BACKUP_RETENTION_DAYS=6
ELN_BACKUP_INTERVAL_HOURS=24
