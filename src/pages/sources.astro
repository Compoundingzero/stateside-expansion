---
import Base from '../layouts/Base.astro';
import {sources,published,rules,toolDefinitions,siteDependencies,tools} from '../lib/content';
---
<Base title="Primary source register and page dependencies"><section class="container"><div class="page-intro"><span class="eyebrow">THE SOURCE REGISTER</span><h1>Follow a claim<br/>back to its evidence.</h1><p class="lede">Source records connect to rules and published pages in both directions. A successful fetch is not substantive verification.</p></div>{sources.map(s=><details id={s.id}><summary>{s.title} <span class="meta">{s.authority}</span></summary><div class="source-record"><a href={s.url}>{s.url}</a><p>{s.type} · {s.section} · {s.legalStatus}</p>{s.supportingPassage&&<blockquote>{s.supportingPassage}</blockquote>}<p>Fetched: {s.fetchedAt??'not fetched'}<br/>Substantive verification: {s.substantiveVerifiedAt??'not verified'}<br/>Next review target: {s.nextReview??'not assigned'}<br/>Access: {s.accessStatus??'not recorded'}</p><p>{s.notes}</p><p class="meta">{s.reviewerStatus}</p><h3>Dependent public guides</h3><ul>{published.filter(g=>g.sourceIds?.includes(s.id)||g.ruleIds?.some((id:string)=>rules.some(r=>r.id===id&&r.sourceIds?.includes(s.id)))).map(g=><li><a href={g.path}>{g.title}</a></li>)}</ul><h3>Planning tools and reference pages</h3><ul>{[...toolDefinitions,...siteDependencies].filter(d=>d.sourceIds?.includes(s.id)||d.ruleIds?.some((id:string)=>rules.some(r=>r.id===id&&r.sourceIds?.includes(s.id)))).map(d=><li><a href={d.path}>{d.title??tools.find(t=>d.path==='/tools/'+t.slug+'/')?.name??d.path}</a></li>)}</ul><h3>Canonical rules</h3><ul>{rules.filter(r=>r.sourceIds?.includes(s.id)).map(r=><li>{r.id}: {r.title} — {r.status}</li>)}</ul></div></details>)}</section></Base>
