---
import Base from '../layouts/Base.astro';
import {published} from '../lib/content';
const families=[...new Set(published.map(g=>g.family))];
const documentedCases=published.filter(g=>g.family==='case'&&g.scenarioType==='real');
---
<Base title="Field guides for expanding an established business to the U.S."><section class="container"><div class="page-intro"><span class="eyebrow">THE REFERENCE DESK</span><h1>Understand the decision.<br/>Prepare the next step.</h1><p class="lede">Research for the team taking an existing business model to the United States. Each published guide has its own sources, preparation task and coverage limits.</p><p class="meta">{published.length} published canonical guides · Additional candidates remain outside the public guide inventory.</p></div><label class="search-field"> <span class="visually-hidden">Search guides</span><input id="guide-search" type="search" placeholder="Search a question, industry or jurisdiction…"/></label><ul class="filter-list" aria-label="Guide families"><li><button data-family="all" aria-pressed="true">All guides</button></li><li><button data-family="documented-case" aria-pressed="false">Documented cases ({documentedCases.length})</button></li>{families.map(f=><li><button data-family={f} aria-pressed="false">{f.replaceAll('-',' ')}</button></li>)}</ul><div class="library-list">{published.map(g=><a class="library-row guide-entry" href={g.path} data-family={g.family} data-case-type={g.scenarioType} data-text={[g.title,g.description,...g.jurisdictions].join(' ').toLowerCase()}><span class="category">{g.scenarioType==='real'?'Documented case':g.scenarioType==='fictional'?'Fictional scenario':g.family?.replaceAll('-',' ')}</span><div><h3>{g.title}</h3><p>{g.description}</p><span class="meta">AI-assisted source review: {g.lastReviewed??'date not recorded'} · {g.readMinutes} min read</span></div><span class="arrow" aria-hidden="true"><span class="arrow-icon" aria-hidden="true"></span></span></a>)}</div><p id="no-results" class="empty" hidden>No published guide matches this search. Check the coverage register for work still in research.</p></section></Base>
<script>let family='all';const input=document.querySelector<HTMLInputElement>('#guide-search');function filter(){let count=0;document.querySelectorAll<HTMLElement>('.guide-entry').forEach(e=>{const show=(family==='all'||(family==='documented-case'?e.dataset.caseType==='real':e.dataset.family===family))&&(e.dataset.text??'').includes(input?.value.toLowerCase()??'');e.hidden=!show;if(show)count++});document.querySelector<HTMLElement>('#no-results')!.hidden=count>0;}input?.addEventListener('input',filter);document.querySelectorAll<HTMLButtonElement>('[data-family][aria-pressed]').forEach(b=>b.addEventListener('click',()=>{family=b.dataset.family!;document.querySelectorAll('[data-family][aria-pressed]').forEach(x=>x.setAttribute('aria-pressed',String(x===b)));filter()}));</script>
