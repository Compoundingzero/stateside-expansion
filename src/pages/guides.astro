---
import Base from '../layouts/Base.astro';
import {published} from '../lib/content';
import {learningHubs,hubPath,guidesForHub,latestContentModified,readingLabel} from '../lib/article-presentation';
const families=[...new Set(published.map(g=>g.family))];
const documentedCases=published.filter(g=>g.family==='case'&&g.scenarioType==='real');
const learningTopics=learningHubs.filter(hub=>hub.kind==='topic');
const collections=learningHubs.filter(hub=>hub.kind==='family');
const familyLabels=new Map(collections.map(hub=>[hub.slug,hub.label]));
const breadcrumbs=[{name:'Home',path:'/'},{name:'Field guides',path:'/guides/'}];
---
<Base title="Field guides for expanding an established business to the U.S." breadcrumbs={breadcrumbs} contentModifiedAt={latestContentModified(published)}><section class="container"><div class="page-intro"><span class="eyebrow">THE REFERENCE DESK</span><h1>Understand the decision.<br/>Prepare the next step.</h1><p class="lede">Research for the team taking an existing business model to the United States. Each published guide has its own sources, preparation task and coverage limits.</p><p class="meta">{published.length} published guides · Each guide states its own scope and remaining questions.</p><nav class="library-entry-links" aria-label="Browse or search"><a href="#choose-question">Choose a subject</a><a href="#all-guides-heading">Search all guides</a></nav></div><section class="guide-pathways" aria-labelledby="choose-question"><h2 id="choose-question">Start with your question</h2><p>Choose a subject to see a focused set of guides, or browse the collections below.</p><ul class="learning-path-grid">{learningTopics.map(hub=><li><a href={hubPath(hub)}><strong>{hub.label}</strong><span>{hub.description}</span><small>{guidesForHub(hub,published).length} guides</small></a></li>)}</ul><nav class="guide-collections" aria-label="Guide collections"><h3>Browse a collection</h3><ul>{collections.map(hub=><li><a href={hubPath(hub)}>{hub.label}<span class="meta"> {guidesForHub(hub,published).length}</span></a></li>)}</ul></nav></section><section class="all-guides" aria-labelledby="all-guides-heading"><h2 id="all-guides-heading">All field guides</h2><label class="search-field"> <span class="visually-hidden">Search guides</span><input id="guide-search" type="search" placeholder="Search a question, industry or jurisdiction…"/></label><ul class="filter-list" aria-label="Guide families"><li><button data-family="all" aria-pressed="true">All guides</button></li><li><button data-family="documented-case" aria-pressed="false">Documented cases ({documentedCases.length})</button></li>{families.map(f=><li><button data-family={f} aria-pressed="false">{familyLabels.get(f)??f.replaceAll('-',' ')}</button></li>)}</ul><div class="library-list">{published.map(g=><a class="library-row guide-entry" href={g.path} data-family={g.family} data-case-type={g.scenarioType} data-text={[g.title,g.seoTitle,g.description,...g.jurisdictions,...(g.keyTerms??[]).map((entry:any)=>entry.term)].join(' ').toLowerCase()}><span class="category">{g.scenarioType==='real'?'Documented case':g.scenarioType==='fictional'?'Fictional scenario':familyLabels.get(g.family)??g.family?.replaceAll('-',' ')}</span><div><h3>{g.title}</h3><p>{g.description}</p><span class="meta">AI-assisted source review: {g.lastReviewed??'date not recorded'} · {readingLabel(g)}</span></div><span class="arrow" aria-hidden="true"><span class="arrow-icon" aria-hidden="true"></span></span></a>)}</div><p id="no-results" class="empty" hidden>No published guide matches this search. Check the coverage register for work still in research.</p></section></section></Base>
<script>let family='all';const input=document.querySelector<HTMLInputElement>('#guide-search');function filter(){let count=0;document.querySelectorAll<HTMLElement>('.guide-entry').forEach(e=>{const show=(family==='all'||(family==='documented-case'?e.dataset.caseType==='real':e.dataset.family===family))&&(e.dataset.text??'').includes(input?.value.toLowerCase()??'');e.hidden=!show;if(show)count++});document.querySelector<HTMLElement>('#no-results')!.hidden=count>0;}input?.addEventListener('input',filter);document.querySelectorAll<HTMLButtonElement>('[data-family][aria-pressed]').forEach(b=>b.addEventListener('click',()=>{family=b.dataset.family!;document.querySelectorAll('[data-family][aria-pressed]').forEach(x=>x.setAttribute('aria-pressed',String(x===b)));filter()}));</script>
