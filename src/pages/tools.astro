---
import Base from '../layouts/Base.astro';
import {tools} from '../lib/content';
---
<Base title="Practical U.S. expansion planning tools"><section class="container"><div class="page-intro"><span class="eyebrow">THE WORKING DESK</span><h1>Put the assumptions<br/>to work.</h1><p class="lede">Nine tools for decisions your team needs to make. Transparent calculations, visible gaps and one private brief. No account or model subscription required.</p><p class="meta">Planning is browser-local. Use non-sensitive notes. Export or reset whenever you need to.</p></div><div class="library-list">{tools.map((t,i)=><a class="library-row" href={'/tools/'+t.slug+'/'}><span class="category">WORKSHEET / {String(i+1).padStart(2,'0')}</span><div><h3>{t.name}</h3><p>{t.description}</p></div><span class="arrow" aria-hidden="true"><span class="arrow-icon" aria-hidden="true"></span></span></a>)}</div></section></Base>
