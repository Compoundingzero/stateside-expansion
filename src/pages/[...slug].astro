---
import Base from '../layouts/Base.astro';
import {published,sourceById,ruleById,stages} from '../lib/content';
export function getStaticPaths(){return published.map(guide=>({params:{slug:guide.path.replace(/^\/+|\/+$/g,'')},props:{guide}}));}
const {guide:g}=Astro.props;
const sources=(g.sourceIds??[]).map(sourceById).filter(Boolean);
const rules=(g.ruleIds??[]).map(ruleById).filter(Boolean);
const stage=Number.isInteger(g.nextStage)?g.nextStage:1;
const apply='/plan/?'+new URLSearchParams({stage:String(stage),topic:g.topic??g.id,jurisdiction:(g.jurisdictions??[]).join(',')});
const slug=(s:string,i:number)=>'section-'+i;
---
<Base title={g.title} description={g.description} article action="Apply this to our plan" actionHref={apply}><article class="container"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/guides/">Field guides</a><span>/</span><span>{g.family?.replaceAll('-',' ')}</span></nav><header class="page-intro"><span class="eyebrow">{g.family?.replaceAll('-',' ')}{g.scenarioType&&` · ${g.scenarioType==='fictional'?'FICTIONAL WORKED SCENARIO':'DOCUMENTED CASE'}`}</span><h1>{g.title}</h1><p class="lede">{g.description}</p><div class="article-date"><span>Source review: <time datetime={g.lastReviewed}>{g.lastReviewed??'Not recorded'}</time></span><span>{g.readMinutes} min read</span><span>{g.jurisdictions?.join(' · ')}</span></div><p class="meta">{g.reviewStatus??'AI-assisted source review; no professional legal review.'}</p></header><div class="article-layout"><div class="article-body">{g.scenarioType==='fictional'&&<div class="notice">Fictional business and illustrative assumptions. This is a learning exercise, not a customer result or forecast.</div>}{g.sections.map((section:any,i:number)=><section class="anchor-section" id={slug(section.heading,i)}><h2>{section.heading}</h2>{section.paragraphs?.map((p:string)=><p>{p}</p>)}{section.bullets?.length>0&&<ul>{section.bullets.map((b:string)=><li>{b}</li>)}</ul>}{section.table&&<div class="table-wrap" tabindex="0" role="region" aria-label={section.heading+' table'}><table><thead><tr>{section.table.headers.map((h:string)=><th scope="col">{h}</th>)}</tr></thead><tbody>{section.table.rows.map((row:string[])=><tr>{row.map((cell:string)=><td>{cell}</td>)}</tr>)}</tbody></table></div>}{section.sourceIds?.length>0&&<p class="meta">Section sources: {section.sourceIds.map((id:string)=>{const s=sourceById(id);return s?<a href={s.url} rel="noopener">{s.authority}: {s.section??s.title} </a>:null})}</p>}</section>)}<section class="notice"><h3>What your team should prepare</h3><p>{g.practicalOutput}</p><p class="meta">Relevant planning stage: {stages[stage]}. Reading this guide does not complete the underlying task.</p></section>{g.limitations?.length>0&&<section><h2>Coverage limits & open questions</h2><ul>{g.limitations.map((l:string)=><li>{l}</li>)}</ul></section>}{rules.length>0&&<details><summary>Canonical rule records used by this guide ({rules.length})</summary><div>{rules.map((r:any)=><div class="source-record"><strong>{r.title}</strong> <span class:list={['pill',r.status]}>{r.status}</span><p>{r.requirement}</p><p class="meta">{r.id} · Trigger: {r.trigger} · Review: {r.verifiedAt??'not verified'} · {r.legalStatus}</p>{r.sourceIds?.map((id:string)=>{const s=sourceById(id);return s?<a href={s.url}>{s.title} </a>:null})}</div>)}</div></details>}<section class="sources" id="sources"><h2>Sources & review notes</h2><p class="meta">Source access, substantive verification and page modification are separate events. This batch received AI-assisted source review. It has not received professional legal review.</p>{sources.map((s:any)=><div class="source-record"><a href={s.url} rel="noopener">{s.title}</a><p>{s.authority} · {s.type} · {s.section}</p>{s.supportingPassage&&<blockquote>{s.supportingPassage}</blockquote>}<p class="meta">Fetched: {s.fetchedAt??'not fetched'} · Substantive review: {s.substantiveVerifiedAt??'not verified'} · Next review target: {s.nextReview??'not set'}</p>{s.notes&&<p>{s.notes}</p>}</div>)}</section><section class="sources"><h3>Related preparation</h3><ul>{published.filter(x=>x.id!==g.id&&(x.topic===g.topic||x.family===g.family||x.jurisdictions?.some((j:string)=>g.jurisdictions?.includes(j)))).slice(0,4).map(x=><li><a href={x.path}>{x.title}</a></li>)}</ul></section></div><aside class="article-aside"><strong>In this guide</strong><ol>{g.sections.map((s:any,i:number)=><li><a href={'#'+slug(s.heading,i)}>{s.heading}</a></li>)}<li><a href="#sources">Sources & review notes</a></li></ol><p class="meta">Practical output</p><p>{g.practicalOutput}</p></aside></div></article></Base>
