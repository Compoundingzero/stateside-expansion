---
import '../styles/global.css';
import {pageSchema,breadcrumbSchema,recordedModifiedAt,serializeStructuredData} from '../lib/article-presentation';
const {
  title='Build a U.S. expansion plan your management team can execute',
  description='Practical U.S. expansion research and planning for established European and Southeast Asian businesses.',
  action='Build our U.S. plan',actionHref='/plan/',hideAction=false,noindex=false,article=false,
  headline=title,contentModifiedAt,breadcrumbs=[],
}=Astro.props;
const site=Astro.site??new URL(Astro.url.origin);
const canonical=new URL(Astro.url.pathname,site);
const modified=recordedModifiedAt(contentModifiedAt);
const schema=pageSchema({site,path:Astro.url.pathname,title,description,article,headline,contentModifiedAt:modified});
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width,initial-scale=1"/>
    <meta name="description" content={description}/>
    <meta name="theme-color" content="#152c36"/>
    <title>{title} | ELN</title>
    <link rel="canonical" href={canonical}/>
    {noindex&&<meta name="robots" content="noindex,nofollow"/>}
    <meta property="og:title" content={title}/>
    <meta property="og:description" content={description}/>
    <meta property="og:type" content={article?'article':'website'}/>
    <meta property="og:url" content={canonical}/>
    <meta property="og:site_name" content="ELN — Enterprise Licensing Network"/>
    {article&&modified&&<meta property="article:modified_time" content={modified}/>}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
    <script type="application/ld+json" set:html={serializeStructuredData(schema)}/>
    {breadcrumbs.length>0&&<script type="application/ld+json" set:html={serializeStructuredData(breadcrumbSchema(breadcrumbs,site))}/>}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="wordmark" href="/" aria-label="ELN home"><span class="brand-mark" aria-hidden="true"><span class="arrow-icon" aria-hidden="true"></span></span>ELN<span class="brand-description">ENTERPRISE LICENSING NETWORK</span></a>
      <nav aria-label="Main navigation"><a href="/guides/">Field guides</a><a href="/tools/">Planning tools</a><a href="/coverage/">Research coverage</a><a href="/interest/" class="nav-plan">Network <span aria-hidden="true"><span class="arrow-icon" aria-hidden="true"></span></span></a></nav>
    </header>
    <main id="main"><slot/></main>
    <footer class="site-footer">
      <div><a class="wordmark" href="/">ELN<span class="brand-description">ENTERPRISE LICENSING NETWORK</span></a><p>For established businesses. For the team doing the work.</p></div>
      <div class="footer-links"><a href="/methodology/">Sources &amp; editorial method</a><a href="/privacy/">Privacy &amp; data controls</a><a href="/contact/">Contact us</a><a href="/coverage/">Coverage &amp; open questions</a></div>
      <p class="footer-note">Educational preparation. No automated legal clearance, partner certification, or visa determination. AI-assisted source review; no professional legal review.</p>
    </footer>
    {!hideAction&&<div class="action-bar"><div><span class="action-kicker">YOUR NEXT USEFUL STEP</span><span class="action-context">A considered decision starts with a clear brief.</span></div><a class="button" href={actionHref} data-forward-cta>{action}<span aria-hidden="true"><span class="arrow-icon" aria-hidden="true"></span></span></a></div>}
  </body>
</html>
