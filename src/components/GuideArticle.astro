---
import Base from '../layouts/Base.astro';
import {published,sourceById,ruleById,stages,relevantCases} from '../lib/content';
const {guide:g}=Astro.props;
const sources=(g.sourceIds??[]).map(sourceById).filter(Boolean);
const rules=(g.ruleIds??[]).map(ruleById).filter(Boolean);
const cases=relevantCases(g);
const stage=Number.isInteger(g.nextStage)?g.nextStage:1;
const apply='/plan/?'+new URLSearchParams({stage:String(stage),topic:g.topic??g.id,jurisdiction:(g.jurisdictions??[]).join(',')});
const slug=(s:string,i:number)=>'section-'+i;
const ruleStatus=(status:string)=>({'verified':'Source checked','conditional':'Depends on the facts','unresolved':'Still unresolved'}[status]??status);
const familyLabel=({'fdd':'Franchise Disclosure Document','federal':'U.S. federal rules','state':'State guide','state-issue':'State rule explained','origin':'From your home country','territory':'U.S. territory guide','industry':'Industry guide','local':'Local operating guide','case':'Case study','comparison':'Compare the options','decision':'Expansion planning'}[g.family]??g.family?.replaceAll('-',' '));
const updated=g.contentModifiedAt?new Intl.DateTimeFormat('en-US',{timeZone:'UTC',month:'long',day:'numeric',year:'numeric'}).format(new Date(g.contentModifiedAt)):null;
const isReferenceGuide=g.sections.filter((s:any)=>s.table).length>=20;
const jurisdictionLabel=g.id==='state-employer-payroll-registration'?'All 50 U.S. states and Washington, D.C.':g.jurisdictions?.join(' · ');
---
<Base title={g.title} description={g.description} article action="Apply this to our plan" actionHref={apply}>
  <article class="container">
    <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/guides/">Field guides</a><span>/</span><span>{familyLabel}</span></nav>
    <header class="page-intro">
      <span class="eyebrow">{familyLabel}{g.scenarioType&&` · ${g.scenarioType==='fictional'?'FICTIONAL WORKED SCENARIO':'DOCUMENTED CASE'}`}</span>
      <h1>{g.title}</h1>
      <p class="lede">{g.description}</p>
      <div class="article-date"><span>Source review: <time datetime={g.lastReviewed}>{g.lastReviewed??'Not recorded'}</time></span>{updated&&<span>Explanation updated: <time datetime={g.contentModifiedAt}>{updated}</time></span>}<span>{isReferenceGuide?'Reference guide: read the introduction, then choose the section you need.':`About ${g.readMinutes} min read`}</span><span>{jurisdictionLabel}</span></div>
    </header>
    <div class="article-layout">
      <div class="article-body">
        {g.scenarioType==='fictional'&&<div class="notice">Fictional business and illustrative assumptions. This is a learning exercise, not a customer result or forecast.</div>}
        <details class="mobile-article-contents"><summary>On this page</summary><nav aria-label="Sections in this guide"><ol>{g.learningSummary&&<li><a href="#start-here">The idea in plain English</a></li>}{g.keyTerms?.length>0&&<li><a href="#words-to-know">Words used in this guide</a></li>}{g.sections.map((s:any,i:number)=><li><a href={'#'+slug(s.heading,i)}>{s.heading}</a></li>)}<li><a href="#sources">Sources &amp; review notes</a></li></ol></nav></details>
        {g.learningSummary&&<section class="article-overview anchor-section" id="start-here"><h2>The idea in plain English</h2><p>{g.learningSummary}</p></section>}
        {g.keyTerms?.length>0&&<section class="article-terms anchor-section" id="words-to-know"><h2>Words used in this guide</h2><dl>{g.keyTerms.map((entry:any)=><div><dt>{entry.term}</dt><dd>{entry.meaning}</dd></div>)}</dl></section>}
        {g.sections.map((section:any,i:number)=><section class="anchor-section" id={slug(section.heading,i)}>
          <h2>{section.heading}</h2>
          {section.paragraphs?.map((p:string)=><p>{p}</p>)}
          {section.bullets?.length>0&&<ul>{section.bullets.map((b:string)=><li>{b}</li>)}</ul>}
          {section.table&&<div class="table-wrap" tabindex="0" role="region" aria-label={section.heading+' table'}><table><thead><tr>{section.table.headers.map((h:string)=><th scope="col">{h}</th>)}</tr></thead><tbody>{section.table.rows.map((row:string[])=><tr>{row.map((cell:string)=><td>{cell}</td>)}</tr>)}</tbody></table></div>}
          {section.sourceIds?.length>0&&<p class="meta section-citations">Official sources for this explanation: {section.sourceIds.map((id:string)=>{const s=sourceById(id);return s?<a href={s.url} rel="noopener">{s.authority}: {s.section??s.title} </a>:null})}</p>}
        </section>)}
        <section class="notice"><h3>What your team should prepare</h3><p>{g.practicalOutput}</p><p class="meta">Relevant planning stage: {stages[stage]}. Reading the explanation helps you prepare; the underlying application, agreement or business decision still needs to be completed.</p></section>
        {g.limitations?.length>0&&<section><h2>What this guide does not settle</h2><ul>{g.limitations.map((l:string)=><li>{l}</li>)}</ul></section>}
        {g.family==='fdd'&&<section class="official-reading sources"><h2>Read the official federal explanation</h2><p>The Federal Trade Commission (FTC) is the U.S. agency responsible for the federal Franchise Rule. These resources help you move from this explanation to the original requirements.</p><ul><li><a href="https://www.ftc.gov/legal-library/browse/rules/franchise-rule">FTC Franchise Rule overview</a> — the rule’s purpose and links to official materials.</li><li><a href="https://www.ftc.gov/business-guidance/resources/franchise-rule-compliance-guide">FTC Franchise Rule Compliance Guide</a> — worked explanations of the disclosure requirements, with a <a href="https://www.ftc.gov/system/files/documents/plain-language/bus70-franchise-rule-compliance-guide.pdf">printable PDF</a>.</li><li><a href="https://www.ecfr.gov/current/title-16/chapter-I/subchapter-D/part-436">Current 16 CFR Part 436</a> — CFR means Code of Federal Regulations; Part 436 contains the actual federal franchise requirements.</li></ul><p class="meta">The Compliance Guide was published in May 2008. It explains the rule but does not change it; use the current regulation and later official updates for current requirements and dollar amounts. State and territorial requirements are separate.</p></section>}
        {rules.length>0&&<details class="article-rule-details"><summary>Read the detailed rules behind this guide ({rules.length})</summary><div><p>These records show the requirement, when it may apply and the official material supporting it.</p>{rules.map((r:any)=><div class="source-record"><strong>{r.title}</strong> <span class:list={['pill',r.status]}>{ruleStatus(r.status)}</span><p>{r.requirement}</p><p class="meta">When to check: {r.trigger}. Source review: {r.verifiedAt??'not verified'}.</p>{r.sourceIds?.map((id:string)=>{const s=sourceById(id);return s?<a href={s.url}>{s.title} </a>:null})}</div>)}</div></details>}
        {cases.length>0&&<section class="sources"><h2>Relevant documented cases</h2><p>These real records show how the issue arose in practice. A complaint describes allegations; a judgment or settlement has its own legal effect. Each case guide explains which kind of record is available.</p>{cases.map(({link,guide:caseGuide})=><div class="source-record"><h3><a href={caseGuide!.path}>{caseGuide!.title}</a></h3><p>{link.explanation}</p></div>)}</section>}
        <section class="sources" id="sources"><h2>Sources &amp; review notes</h2><p>These are the official materials behind the explanation. The site uses AI-assisted source research and has not received professional legal review. A retrieval date records when a source was accessed; a substantive review date records when its meaning was checked.</p>{sources.map((s:any)=><div class="source-record article-source"><a class="source-title" href={s.url} rel="noopener">{s.title}</a><p>{s.authority}</p><details><summary>See the source passage and review notes</summary><div><p>{s.type} · {s.section}</p>{s.supportingPassage&&<blockquote>{s.supportingPassage}</blockquote>}<p class="meta">Accessed: {s.fetchedAt??'not fetched'} · Meaning reviewed: {s.substantiveVerifiedAt??'not verified'} · Next review target: {s.nextReview??'not set'}</p>{s.notes&&<p>{s.notes}</p>}</div></details></div>)}</section>
        <section class="sources"><h3>Related preparation</h3><ul>{published.filter(x=>x.id!==g.id&&(x.topic===g.topic||x.family===g.family||x.jurisdictions?.some((j:string)=>g.jurisdictions?.includes(j)))).slice(0,4).map(x=><li><a href={x.path}>{x.title}</a></li>)}</ul></section>
      </div>
      <aside class="article-aside" tabindex="0" aria-label="In this guide"><strong>In this guide</strong><ol>{g.learningSummary&&<li><a href="#start-here">The idea in plain English</a></li>}{g.keyTerms?.length>0&&<li><a href="#words-to-know">Words used in this guide</a></li>}{g.sections.map((s:any,i:number)=><li><a href={'#'+slug(s.heading,i)}>{s.heading}</a></li>)}<li><a href="#sources">Sources &amp; review notes</a></li></ol><p class="meta">What you will prepare</p><p>{g.practicalOutput}</p></aside>
    </div>
  </article>
</Base>
