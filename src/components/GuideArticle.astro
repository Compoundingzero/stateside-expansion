---
import Base from '../layouts/Base.astro';
import LearningControls from './LearningControls';
import {published,sourceById,ruleById,relevantCases,tools} from '../lib/content';
import {searchTitle,semanticSectionIds,articleBreadcrumbs,relatedReading,recordedModifiedAt,isReferenceGuide,learningHubs} from '../lib/article-presentation';
const {guide:g}=Astro.props;
const sources=(g.sourceIds??[]).map(sourceById).filter(Boolean);
const rules=(g.ruleIds??[]).map(ruleById).filter(Boolean);
const cases=relevantCases(g);
const stage=Number.isInteger(g.nextStage)?g.nextStage:1;
const apply='/plan/?'+new URLSearchParams({stage:String(stage),topic:g.topic??g.id,jurisdiction:(g.jurisdictions??[]).join(',')});
const sections=semanticSectionIds(g.sections??[]);
const breadcrumbs=articleBreadcrumbs(g);
const related=relatedReading(g,published,tools);
const isPayroll=g.id==='state-employer-payroll-registration';
const jurisdictions=isPayroll?sections.filter(({section})=>section.table&&((g.jurisdictions??[]).includes(section.heading)||section.heading==='District of Columbia')):[];
const jurisdictionIds=new Set(jurisdictions.map(entry=>entry.id));
const terms=Array.isArray(g.keyTerms)?g.keyTerms:[];
const tocItems=sections.filter(entry=>!jurisdictionIds.has(entry.id)).map(entry=>({id:entry.id,heading:entry.section.heading}));
const ruleStatus=(status:string)=>({'verified':'Source checked','conditional':'Depends on the facts','unresolved':'Still unresolved'}[status]??status);
const familyLabel=learningHubs.find(hub=>hub.kind==='family'&&hub.slug===g.family)?.label??'Field guide';
const modified=recordedModifiedAt(g.contentModifiedAt);
const updated=modified?new Intl.DateTimeFormat('en-US',{timeZone:'UTC',month:'long',day:'numeric',year:'numeric'}).format(new Date(modified)):null;
const isReference=isReferenceGuide(g);
const jurisdictionLabel=isPayroll?'All 50 U.S. states and Washington, D.C.':g.jurisdictions?.join(' · ');
---
<Base title={searchTitle(g)} headline={g.title} description={g.description} contentModifiedAt={modified} breadcrumbs={breadcrumbs} article action="Apply this to our plan" actionHref={apply}>
  <article class="container owner-article">
    <nav class="breadcrumb" aria-label="Breadcrumb">{breadcrumbs.map((crumb,index)=><>{index>0&&<span aria-hidden="true">/</span>}{index<breadcrumbs.length-1?<a href={crumb.path}>{crumb.name}</a>:<span aria-current="page">{crumb.name}</span>}</>)}</nav>
    <header class="page-intro article-intro">
      <span class="eyebrow">{familyLabel}{g.scenarioType&&' · '+(g.scenarioType==='fictional'?'FICTIONAL SCENARIO':'DOCUMENTED CASE')}</span>
      <h1>{g.title}</h1>
      <p class="article-answer anchor-section" id="start-here">{g.learningSummary}</p>
      {jurisdictions.length>0&&<details class="jurisdiction-jump anchor-section" id="choose-jurisdiction"><summary>Choose a state or Washington, D.C. <span class="meta">({jurisdictions.length} jurisdictions)</span></summary><nav aria-label="Jump to an employer-account jurisdiction"><ul>{jurisdictions.map(entry=><li><a href={'#'+entry.id}>{entry.section.heading}</a></li>)}</ul></nav></details>}
      <div class="article-date"><span>Source review: <time datetime={g.lastReviewed}>{g.lastReviewed??'Not recorded'}</time></span>{updated&&<span>Explanation updated: <time datetime={modified}>{updated}</time></span>}<span>{isReference?'Reference guide':g.readMinutes+' min read'}</span><span>{jurisdictionLabel}</span></div>
    </header>
    <div class="article-layout">
      <div class="article-body">
        {g.scenarioType==='fictional'&&<p class="fiction-note">Fictional business and illustrative assumptions; these are not reported results or a forecast.</p>}
        <details class="mobile-article-contents"><summary>On this page</summary><nav aria-label="Sections in this guide"><ol>{jurisdictions.length>0&&<li><a href="#choose-jurisdiction">Choose a jurisdiction</a></li>}{tocItems.map(({heading,id})=><li><a href={'#'+id}>{heading}</a></li>)}<li><a href="#what-to-prepare">Next step</a></li><li><a href="#sources">Official sources</a></li></ol></nav></details>
        {sections.map(({section,id,aliases})=><section class="anchor-section article-main-section" id={id}>
          {aliases.map(alias=><span id={alias} class="section-alias" aria-hidden="true"></span>)}
          <h2>{section.heading}</h2>
          {section.paragraphs?.map((paragraph:string)=><p>{paragraph}</p>)}
          {section.bullets?.length>0&&<ul>{section.bullets.map((bullet:string)=><li>{bullet}</li>)}</ul>}
          {section.table&&<div class="table-wrap" tabindex="0" role="region" aria-label={section.heading+' table'}><table><thead><tr>{section.table.headers.map((heading:string)=><th scope="col">{heading}</th>)}</tr></thead><tbody>{section.table.rows.map((row:string[])=><tr>{row.map((cell:string)=><td>{cell}</td>)}</tr>)}</tbody></table></div>}
          {section.sourceIds?.length>0&&<p class="meta section-citations">Sources: {section.sourceIds.map((id:string)=>{const source=sourceById(id);return source?<a href={source.url} rel="noopener">{source.authority}: {source.section??source.title} </a>:null})}</p>}
        </section>)}
        {g.limitations?.length>0?<section class="article-scope anchor-section" id="guide-limits"><h2>Scope</h2><ul>{g.limitations.map((limit:string)=><li>{limit}</li>)}</ul></section>:<span id="guide-limits" class="section-alias" aria-hidden="true"></span>}
        <section class="article-next anchor-section" id="what-to-prepare"><h2>Next step</h2><p>{g.practicalOutput}</p></section>
        {terms.length>0?<details class="article-terms article-extra anchor-section" id="words-to-know"><summary>Terms used here</summary><dl>{terms.map((term:any)=><div><dt>{term.term}</dt><dd>{term.meaning}</dd></div>)}</dl></details>:<span id="words-to-know" class="section-alias" aria-hidden="true"></span>}
        <details class="article-references article-extra anchor-section" id="sources">
          <summary>Sources &amp; review notes</summary>
          <div>
            {g.family==='fdd'?<section id="official-federal-explanation" class="anchor-section official-reading"><h3>Federal Franchise Rule</h3><p><a href="https://www.ftc.gov/legal-library/browse/rules/franchise-rule">FTC overview</a> · <a href="https://www.ftc.gov/business-guidance/resources/franchise-rule-compliance-guide">Compliance Guide</a> · <a href="https://www.ftc.gov/system/files/documents/plain-language/bus70-franchise-rule-compliance-guide.pdf">Guide PDF</a> · <a href="https://www.ecfr.gov/current/title-16/chapter-I/subchapter-D/part-436">Current regulation</a></p><p class="meta">The Compliance Guide is May 2008 explanatory guidance. The current regulation and later official updates control current requirements and dollar amounts; state and territorial rules are separate.</p></section>:<span id="official-federal-explanation" class="section-alias" aria-hidden="true"></span>}
            <p class="meta">The source records distinguish access dates from substantive review dates. Updating an explanation does not itself recheck the law.</p>
            {sources.map((source:any)=><div class="source-record article-source"><a class="source-title" href={source.url} rel="noopener">{source.title}</a><p>{source.authority}</p><details><summary>Passage, dates and research notes</summary><div><p>{source.type} · {source.section}</p>{source.supportingPassage&&<blockquote>{source.supportingPassage}</blockquote>}<p class="meta">Accessed: {source.fetchedAt??'not fetched'} · Meaning reviewed: {source.substantiveVerifiedAt??'not verified'} · Next review target: {source.nextReview??'not set'}</p>{source.notes&&<p>{source.notes}</p>}</div></details></div>)}
            {rules.length>0?<details class="article-rule-details anchor-section" id="detailed-rules"><summary>Detailed rule records ({rules.length})</summary><div>{rules.map((rule:any)=><div class="source-record"><strong>{rule.title}</strong> <span class:list={['pill',rule.status]}>{ruleStatus(rule.status)}</span><p>{rule.requirement}</p><p class="meta">When to check: {rule.trigger}. Source review: {rule.verifiedAt??'not verified'}.</p>{rule.sourceIds?.map((id:string)=>{const source=sourceById(id);return source?<a href={source.url}>{source.title} </a>:null})}</div>)}</div></details>:<span id="detailed-rules" class="section-alias" aria-hidden="true"></span>}
            {cases.length>0?<section class="article-case-links anchor-section" id="documented-cases"><h3>Related case records</h3><p class="meta">The case guides distinguish allegations, orders and outcomes.</p><ul>{cases.map(({guide:caseGuide}:any)=><li><a href={caseGuide.path}>{caseGuide.title}</a></li>)}</ul></section>:<span id="documented-cases" class="section-alias" aria-hidden="true"></span>}
          </div>
        </details>
        {related.length>0?<nav class="article-related anchor-section" id="related-preparation" aria-label="Related reading"><h2>Related reading</h2><ul>{related.map(item=><li><a href={item.path}>{item.title}</a></li>)}</ul></nav>:<span id="related-preparation" class="section-alias" aria-hidden="true"></span>}
        <LearningControls client:idle itemId={g.id} path={g.path} title={g.title} type="guide"/>
      </div>
      <aside class="article-aside" tabindex="0" aria-label="In this guide"><strong>On this page</strong><ol>{jurisdictions.length>0&&<li><a href="#choose-jurisdiction">Choose a jurisdiction</a></li>}{tocItems.map(({heading,id})=><li><a href={'#'+id}>{heading}</a></li>)}<li><a href="#what-to-prepare">Next step</a></li><li><a href="#sources">Official sources</a></li></ol></aside>
    </div>
  </article>
</Base>
