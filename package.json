{
  "name": "stateside-expansion-desk",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {"node": ">=22"},
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "node scripts/validate-data.mjs && astro build",
    "preview": "astro preview --host 0.0.0.0",
    "start": "node server.mjs",
    "test": "tsx --test src/lib/*.test.ts tests/*.test.ts",
    "check:sources": "node scripts/check-sources.mjs",
    "report": "node scripts/report.mjs"
  },
  "dependencies": {"astro":"^5.16.0","@astrojs/react":"^4.4.2","react":"^19.2.0","react-dom":"^19.2.0"},
  "devDependencies": {"@types/react":"^19.2.0","@types/react-dom":"^19.2.0","typescript":"^5.9.3","tsx":"^4.20.6","@playwright/test":"^1.56.1"}
}
