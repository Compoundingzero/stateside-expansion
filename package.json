{
  "name": "stateside-expansion-desk",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "node scripts/validate-data.mjs && astro build",
    "preview": "astro preview --host 0.0.0.0",
    "start": "node server.mjs",
    "test": "tsx --test src/lib/*.test.ts tests/*.test.ts",
    "check:sources": "node scripts/check-sources.mjs",
    "report": "node scripts/report.mjs"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.8",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/libre-caslon-display": "^5.3.0",
    "astro": "^7.4.11",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "railway": "^3.16.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
